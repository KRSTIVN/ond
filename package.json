{
  "name": "ond",
  "private": true,
  "version": "1.0.0",
  "description": "Local-first glassmorphic workspace with custom wallpapers: interactive Google Sheets & Excel Kanban board, Temporal Calendar, Markdown Notes, and Scientific & Profession-Formula Calculator.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build",
    "start": "node server.mjs",
    "launch:mac": "bash ./scripts/launch-app.sh",
    "install:mac": "bash ./scripts/install-mac-app.sh",
    "install:win": "powershell -ExecutionPolicy Bypass -File ./scripts/install-shortcut.ps1",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "read-excel-file": "^9.3.20",
    "temporal-polyfill": "^1.0.8",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
