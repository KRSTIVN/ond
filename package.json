{
  "name": "ond",
  "private": true,
  "version": "1.1.0",
  "author": "KRSTIVN",
  "main": "dist-electron/main.cjs",
  "description": "Local-first glassmorphic workspace with custom wallpapers: interactive Google Sheets & Excel Kanban board, Temporal Calendar, Markdown Notes, and Scientific & Industry-Formula Calculator.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "desktop:build": "npm run build && npm run build:electron",
    "desktop:dev": "npm run build:electron && electron .",
    "dist:win": "npm run desktop:build && electron-builder --win --config electron-builder.yml",
    "dist:mac": "npm run desktop:build && electron-builder --mac --universal --config electron-builder.yml",
    "start": "node server.mjs",
    "launch:mac": "bash ./scripts/launch-app.sh",
    "install:mac": "bash ./scripts/install-mac-app.sh",
    "install:win": "powershell -ExecutionPolicy Bypass -File ./scripts/install-shortcut.ps1",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "read-excel-file": "^9.3.20",
    "temporal-polyfill": "^1.0.8",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
